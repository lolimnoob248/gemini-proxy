# Static Bearer token — clients must send this in: Authorization: Bearer <key>
# Generate a strong random value, e.g.: openssl rand -base64 32
PROXY_API_KEY=your-secret-api-key-here

# Port the server listens on (default: 3000)
# PROXY_PORT=3000

# Path to the OAuth token store file (default: ./tokens.json)
# TOKEN_STORE_PATH=./tokens.json
